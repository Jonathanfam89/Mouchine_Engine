<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>GameScripts</AssemblyName>
    <RootNamespace>GameScripts</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

    <DebugType>portable</DebugType>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
	<ItemGroup>
		<Compile Include="..\Assets\Scripts\*.cs"/>
	</ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Message Text="Copying GameScripts.dll to Build folder..." Importance="high" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\Build\Scripts\" />
  </Target>

</Project>